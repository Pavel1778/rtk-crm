# Зависимости
node_modules/

# Артефакты сборки
dist/
build/

# Переменные окружения
.env
.env.local
.env.*
!.env.example
!.env.template
!.env.prod.example

# Ключи и сертификаты
*.pem
*.key
credentials.json
service-account.json
service_account.json
key.json
*.p12
*.pfx

# Исключение: корневой сертификат НУЦ Минцифры — публичный, нужен для TLS к
# GigaChat. Секретом не является и поставляется вместе с исходниками, иначе
# на чистом стенде сводка падает на проверке сертификата.
!backend/certs/
!backend/certs/russian_trusted_root_ca.pem

# Кэш Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Логи
*.log
logs/

# Локальные базы данных
*.db
*.sqlite3

# Локальное хранилище загруженных файлов (создаётся в рантайме)
uploads/

# Данные от кейсодержателя и любые выгрузки со персональными данными.
# В репозиторий они не попадают: «Загрузка пользователей.xlsx» содержит
# поля СНИЛС, паспорта и адреса регистрации (152-ФЗ). Тестовые фикстуры
# для импорта собираются в памяти (см. tests/test_excel_import.py), поэтому
# таблицы в репозитории не нужны.
*.xlsx
*.xls
Вендоры*
Данные оплат*
Загрузка пользователей*

# Исключение: примеры форматов для демонстрации импорта. Обезличенная копия
# «Загрузка пользователей.xlsx» без реальных ПДн (см.
# scripts/anonymize_case_data.py и docs/examples/README.md).
!docs/examples/vendors.xlsx
!docs/examples/users_b2c.xlsx
!frontend/public/docs/examples/vendors.xlsx
!frontend/public/docs/examples/users_b2c.xlsx

