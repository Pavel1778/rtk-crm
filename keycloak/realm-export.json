{
  "realm": "rtk-crm",
  "enabled": true,
  "displayName": "RTK CRM",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1440,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Администратор: справочники, пользователи, настройки"
      },
      {
        "name": "manager",
        "description": "Менеджер: справочники и отчёты по всем вузам"
      },
      {
        "name": "kam",
        "description": "КАМ: заявки и отчёты по своим вузам"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rtk-crm-frontend",
      "name": "RTK CRM Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rtk-crm-frontend",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@rtk-crm.local",
      "email": "admin@rtk-crm.local",
      "firstName": "Администратор",
      "lastName": "Системы",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager@rtk-crm.local",
      "email": "manager@rtk-crm.local",
      "firstName": "Менеджер",
      "lastName": "ИТ-Школы",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Manager123!",
          "temporary": false
        }
      ],
      "realmRoles": ["manager"]
    },
    {
      "username": "kam@rtk-crm.local",
      "email": "kam@rtk-crm.local",
      "firstName": "КАМ",
      "lastName": "Демо",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Kam123!",
          "temporary": false
        }
      ],
      "realmRoles": ["kam"]
    }
  ]
}
