# RTK CRM — переменные окружения для Docker Compose.
#
#   cp .env.example .env    # затем заполнить значения ниже
#
# Этот файл читает docker-compose.yml (через интерполяцию ${VAR}) и backend
# (через env_file). Реальный .env в git не попадает — он в .gitignore.
#
# Значения ниже — заготовки. Перед запуском обязательно замените всё, что
# помечено "заменить".

# --- PostgreSQL ---
# Строка подключения для backend.
# Локально (SQLite, без контейнера с БД):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL в контейнере (docker-compose.prod.yml, профиль Yandex Cloud):
# DATABASE_URL=postgresql+asyncpg://rtk_user:ЗАМЕНИТЬ_ПАРОЛЬ@postgres:5432/rtk_crm
# Yandex Managed PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://rtk_user:ЗАМЕНИТЬ_ПАРОЛЬ@c-<id>.rw.mdb.yandexcloud.net:6432/rtk_crm?ssl=require

# Нужны только для docker-compose.prod.yml (контейнерный PostgreSQL).
POSTGRES_USER=rtk_user
POSTGRES_PASSWORD=ЗАМЕНИТЬ_ПАРОЛЬ
POSTGRES_DB=rtk_crm

# --- JWT ---
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
# В production приложение откажется стартовать с этим значением.
SECRET_KEY=ЗАМЕНИТЬ_СГЕНЕРИРУЙТЕ_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Аутентификация ---
# jwt — локальные пароли; keycloak — SSO (см. docs/KEYCLOAK.md).
AUTH_MODE=jwt
MOCK_MODE=true

# --- MinIO (S3-совместимое хранилище файлов) ---
# MINIO_ROOT_PASSWORD обязателен: без него docker compose откажется стартовать.
MINIO_ROOT_USER=rtk_minio
MINIO_ROOT_PASSWORD=ЗАМЕНИТЬ_ПАРОЛЬ
S3_BUCKET=rtk-crm

# --- Keycloak ---
# Нужен только при AUTH_MODE=keycloak; контейнер Keycloak стартует всегда.
# KEYCLOAK_ADMIN_PASSWORD обязателен: без него docker compose не соберётся.
KEYCLOAK_ADMIN_PASSWORD=ЗАМЕНИТЬ_ПАРОЛЬ
KEYCLOAK_REALM=rtk-crm
KEYCLOAK_CLIENT_ID=rtk-crm-frontend
# Публичный адрес Keycloak — тот, по которому его открывает браузер.
# Keycloak подставляет его в claim `iss`, поэтому по нему проверяется issuer
# токена, а публичный ключ (JWKS) забирается по внутреннему http://keycloak:8080.
# На ВМ укажите http://<ip-вм>:8080 — иначе вход вернёт 401.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Пустая audience отключает проверку aud в токене.
# KEYCLOAK_AUDIENCE=rtk-crm-frontend

# --- Redis (кэш агрегатов отчётов, счётчик лимита входа) ---
# Адрес задаётся в docker-compose.yml; для запуска без Docker:
# REDIS_URL=redis://localhost:6379/0

# --- GigaChat (сводка по взаимодействию, ФТ-6) ---
# Без ключа функция выключена: эндпоинт отвечает 503, вкладка «Сводка»
# сообщает, что сервис не настроен. Демо-контур работает без ключа.
# GIGACHAT_CREDENTIALS=<authorization-key-base64>
# GIGACHAT_SCOPE=GIGACHAT_API_B2B
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_CA_BUNDLE=/etc/ssl/certs/russian_trusted_root_ca.pem
# GIGACHAT_VERIFY_SSL=true

# --- Уведомления о «зависших» заявках ---
STUCK_TIMEOUT_DAYS=14
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_INTERVAL_HOURS=12
# TELEGRAM_BOT_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Прочее ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
SEED_DEMO_DATA=true
