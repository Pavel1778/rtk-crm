<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="RTK CRM" id="model-rtk-crm" version="5.0.0">
  <folder name="Бизнес-слой" id="folder-business" type="business">
    <element id="el-001" xsi:type="archimate:BusinessActor" name="КАМ" documentation="Менеджер по вузам, около 20 человек"/>
    <element id="el-002" xsi:type="archimate:BusinessRole" name="Руководитель" documentation="Руководитель менеджеров по вузам"/>
    <element id="el-003" xsi:type="archimate:BusinessRole" name="Администратор платформы" documentation="Технические специалисты ИТ Школы"/>
    <element id="el-004" xsi:type="archimate:BusinessService" name="Управление взаимодействием с вузами" documentation="Пять шагов ТЗ: импорт, доска, карточка, смена этапа, отчёт"/>
    <element id="el-005" xsi:type="archimate:BusinessObject" name="Взаимодействие" documentation="Карточка вуза: договор, задачи, файлы"/>
  </folder>
  <folder name="Прикладной слой" id="folder-application" type="application">
    <element id="el-006" xsi:type="archimate:ApplicationService" name="Interactions API"/>
    <element id="el-007" xsi:type="archimate:ApplicationService" name="Catalogs / Import API"/>
    <element id="el-008" xsi:type="archimate:ApplicationService" name="Reports / Export API"/>
    <element id="el-009" xsi:type="archimate:ApplicationService" name="Audit API"/>
    <element id="el-010" xsi:type="archimate:ApplicationService" name="Auth + RBAC"/>
    <element id="el-011" xsi:type="archimate:ApplicationService" name="Integration API" documentation="Обмен с LMS и CMS по JSON (ФТ-5)"/>
    <element id="el-012" xsi:type="archimate:ApplicationComponent" name="React SPA" documentation="React 18, TypeScript, Ant Design 5"/>
    <element id="el-013" xsi:type="archimate:ApplicationComponent" name="FastAPI Backend" documentation="Python 3.11, SQLAlchemy 2 async"/>
    <element id="el-014" xsi:type="archimate:ApplicationComponent" name="SQLAlchemy ORM / репозитории"/>
    <element id="el-015" xsi:type="archimate:ApplicationComponent" name="Workflow B2B / B2C" documentation="14 и 4 этапа"/>
    <element id="el-016" xsi:type="archimate:ApplicationComponent" name="Report cache" documentation="Redis / KeyDB"/>
    <element id="el-017" xsi:type="archimate:ApplicationComponent" name="Планировщик уведомлений" documentation="APScheduler: зависшие заявки"/>
    <element id="el-018" xsi:type="archimate:ApplicationComponent" name="File storage" documentation="S3 / MinIO, presigned URL"/>
    <element id="el-019" xsi:type="archimate:ApplicationComponent" name="LMS ИТ Школы" documentation="Внешняя система, источник данных"/>
    <element id="el-020" xsi:type="archimate:ApplicationComponent" name="Веб-сайт ИТ Школы (CMS)" documentation="Внешняя система"/>
  </folder>
  <folder name="Технологический слой" id="folder-technology" type="technology">
    <element id="el-021" xsi:type="archimate:TechnologyService" name="PostgreSQL" documentation="Managed-кластер или контейнер"/>
    <element id="el-022" xsi:type="archimate:TechnologyService" name="Yandex Object Storage" documentation="Файлы, регион РФ"/>
    <element id="el-023" xsi:type="archimate:TechnologyService" name="KeyDB" documentation="Кэш агрегатов отчётов"/>
    <element id="el-024" xsi:type="archimate:TechnologyService" name="Nginx" documentation="Статика SPA и прокси /api"/>
    <element id="el-025" xsi:type="archimate:Node" name="ВМ Yandex Cloud" documentation="Основной контур, 152-ФЗ"/>
  </folder>
