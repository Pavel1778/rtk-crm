# Переменные окружения прод-стека в Yandex Cloud.
# Скопируйте в .env в корне репозитория и заполните секреты:
#   cp infra/yandex-cloud/.env.prod.example .env
# Файл .env в git не попадает, а этот пример — попадает (нужен для деплоя).

# --- Домен и TLS ---
# Домен, на который выпускается сертификат и на который отвечает nginx.
DOMAIN=rtk-crm.ru
# true  — nginx слушает 80 (редирект) и 443 (сертификат Let's Encrypt);
# false — только 80, всё отдаётся напрямую. Режим false нужен для отладки
# по IP, когда домена и сертификата ещё нет: с true nginx не стартует без
# /etc/letsencrypt/live/$DOMAIN/fullchain.pem.
TLS_ENABLED=false

# --- База данных (контейнер postgres в том же compose) ---
POSTGRES_USER=rtk_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rtk_crm
# Хост `postgres` — имя сервиса в docker-compose, а не localhost.
DATABASE_URL=postgresql+asyncpg://rtk_user:CHANGE_ME@postgres:5432/rtk_crm

# --- Секреты ---
# Имя переменной — SECRET_KEY: именно его читает backend/core/config.py.
# Минимум 32 символа, иначе приложение не стартует в production.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

# --- Демо-данные ---
# true обязателен для демонстрации: без него база пустая, нет ни админа,
# ни справочников, и войти в интерфейс некуда.
SEED_DEMO_DATA=true

# --- CORS ---
# В прод-схеме фронтенд и backend за одним nginx, поэтому запросы
# same-origin и CORS фактически не участвует. Значение нужно на случай
# прямого обращения к API с другого origin.
CORS_ORIGINS=https://rtk-crm.ru

# --- Хранилище файлов ---
# S3_ENDPOINT пустой = файлы пишутся в локальный uploads/ внутри контейнера.
# Для MinIO/S3 раскомментируйте и заполните блок ниже.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rtk-crm
S3_SECURE=false

# --- Прочее ---
# ENVIRONMENT=production включает проверку SECRET_KEY при старте:
# приложение откажется подниматься, если ключ короче 32 символов или равен
# значению по умолчанию. Это защита от выката прод-стенда со слабым ключом.
ENVIRONMENT=production
# MOCK_MODE=true — вход по логину/паролю из БД, Keycloak не используется.
MOCK_MODE=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
