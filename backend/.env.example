# RTK CRM Backend Environment Variables

# --- Application ---
APP_NAME=RTK CRM
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/rtk_crm

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security ---
SECRET_KEY=change-me-in-production-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=

# --- Keycloak (optional, only if MOCK_MODE=false) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=rtk-crm
KEYCLOAK_CLIENT_ID=rtk-crm-web

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rtk-crm-files
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Mode ---
MOCK_MODE=true

# --- Files ---
MAX_FILE_SIZE_MB=50

# --- Notifications ---
STALE_STATUS_DAYS=14

# --- Email / SMTP (152-ФЗ — российский провайдер) ---
# Для Яндекс.Почты: включить IMAP/SMTP, создать пароль приложения
EMAIL_ENABLED=false
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=rtk-crm-notify@yandex.ru
EMAIL_PASSWORD=
EMAIL_FROM=rtk-crm-notify@yandex.ru
EMAIL_FROM_NAME=RTK CRM
EMAIL_USE_TLS=true
