# Backend: переменные окружения.
# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# --- Вариант 1: локальная разработка (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Вариант 2: Yandex Managed PostgreSQL ---
# DATABASE_URL=postgresql+asyncpg://rtk_user:<password>@c-<cluster-id>.rw.mdb.yandexcloud.net:6432/rtk_crm?ssl=require

# --- Вариант 3: PostgreSQL в контейнере на ВМ Yandex Cloud ---
# DATABASE_URL=postgresql+asyncpg://rtk_user:<password>@postgres:5432/rtk_crm

# Необязательный кэш отчётов и счётчик лимита логина: Redis или KeyDB
# (без URL используется in-process fallback)
# REDIS_URL=redis://keydb:6379/0

# S3-хранилище файлов: Yandex Object Storage или MinIO.
# Без S3_ENDPOINT файлы пишутся в локальный uploads/
# Yandex Object Storage:
# S3_ENDPOINT=storage.yandexcloud.net
# S3_SECURE=true
# S3_REGION=ru-central1
# Локальный MinIO:
# S3_ENDPOINT=localhost:9000
# S3_SECURE=false
# S3_ACCESS_KEY=rtk_minio
# S3_SECRET_KEY=<minio-root-password>
# S3_BUCKET=rtk-crm

# Лимит попыток входа с одного IP (0 отключает ограничение)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Уведомления о «зависших» заявках (дни порога и периодичность проверки, часы)
STUCK_TIMEOUT_DAYS=14
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_INTERVAL_HOURS=12
# Каналы (пустые значения = канал выключен)
# TELEGRAM_BOT_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Секрет для подписи JWT (минимум 32 символа)
SECRET_KEY=<generate-a-unique-secret-at-least-32-chars>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Текущий режим JWT + БД; Keycloak включается отдельно в закрытом контуре.
MOCK_MODE=true

# Домены фронтенда через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Загружать демо-данные при старте
SEED_DEMO_DATA=true
